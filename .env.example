# Copy this file to .env.local and fill in real values for local development.
# Do NOT commit your real .env.local to source control.

# Database
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Auth
# Generate a bcrypt hash for your chosen password and set it as OWNER_PASSWORD_HASH.
# Example (Node):
#   node -e "console.log(require('bcryptjs').hashSync('YourPasswordHere', 10))"
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=<bcrypt-hash-of-your-password>

# Secrets
AUTH_SECRET=<strong-random-secret>
BETTER_AUTH_SECRET=<strong-random-secret>
